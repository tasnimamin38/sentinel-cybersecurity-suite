# Copy to .env and replace the placeholders before running.
# Generate random values with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-64-character-random-hex
SENTINEL_API_KEY=replace-with-64-character-random-hex
# Optional during controlled key rotation: old-key,new-key (each 32+ characters)
SENTINEL_API_KEYS=
# Optional static service identities: JSON array of {id,key,role,rate_limit_per_minute,daily_request_limit}; keep real keys in a secret manager.
# Optional quotas: 1-600 requests/minute (default 120), 1-1,000,000/day (default 10000).
SENTINEL_API_CREDENTIALS_JSON=
SENTINEL_ALLOWED_DOMAINS=example.com
SENTINEL_CORS_ORIGINS=http://localhost:8080
SENTINEL_REQUEST_TIMEOUT_SECONDS=8
SENTINEL_MAX_ASSESSMENT_RECORDS=250
VITE_API_BASE_URL=http://localhost:8000
# Optional Prometheus metrics endpoint; disabled by default.
# When enabled, set a separate random 32+ character token; never reuse an API key.
# Keep API access loopback-bound and do not expose /metrics on an untrusted network.
SENTINEL_METRICS_ENABLED=false
SENTINEL_METRICS_TOKEN=
