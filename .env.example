# Copy this file to .env and replace every placeholder before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SENTINEL_API_KEY=replace-with-at-least-32-random-bytes
SENTINEL_ALLOWED_DOMAINS=example.com
SENTINEL_CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000