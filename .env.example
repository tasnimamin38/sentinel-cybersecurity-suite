# Copy to .env and replace the placeholders before running.
# Generate random values with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-64-character-random-hex
REDIS_PASSWORD=replace-with-64-character-random-hex
SENTINEL_API_KEY=replace-with-64-character-random-hex
# Optional during controlled key rotation: old-key,new-key (each 32+ characters)
SENTINEL_API_KEYS=
# Optional static service identities: JSON array of {id,key,role}; keep real keys in a secret manager.
SENTINEL_API_CREDENTIALS_JSON=
SENTINEL_ALLOWED_DOMAINS=example.com
# Production accepts exact HTTPS origins only. Same-origin localhost Compose use does not need CORS.
SENTINEL_CORS_ORIGINS=https://console.example.com
SENTINEL_REQUEST_TIMEOUT_SECONDS=8
SENTINEL_MAX_ASSESSMENT_RECORDS=250
SENTINEL_MAX_REQUEST_BODY_BYTES=524288
# Keep these aligned with the Docker Compose sentinel-web subnet.
SENTINEL_WEB_SUBNET=172.30.240.0/24
SENTINEL_TRUSTED_PROXY_CIDRS=172.30.240.0/24
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60
SENTINEL_API_RATE_LIMIT_PER_MINUTE=120
SENTINEL_IP_RATE_LIMIT_PER_MINUTE=300
SENTINEL_HONEYPOT_EVENT_LIMIT_PER_MINUTE=10
SENTINEL_SECURITY_EVENT_AUDIT_LIMIT_PER_MINUTE=10
SENTINEL_ASSESSMENT_RATE_LIMIT_PER_MINUTE=10
SENTINEL_SECRET_SCAN_RATE_LIMIT_PER_MINUTE=20
SENTINEL_AUTH_FAILURE_THRESHOLD=5
SENTINEL_AUTH_FAILURE_WINDOW_SECONDS=300
# Optional: use an operator-controlled HTTPS endpoint; secret must be 32+ chars.
SENTINEL_SECURITY_ALERT_WEBHOOK_URL=
SENTINEL_SECURITY_ALERT_WEBHOOK_SECRET=
